# Non-secret local defaults. Copy to .env and fill secrets as needed.
DATABASE_URL=postgresql://prospector:prospector@localhost:5432/prospector
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=prospector
PROSPECTOR_API_TOKEN=dev-token-change-me

# Research model and web search credentials
PROSPECTOR_LLM_BASE_URL=
PROSPECTOR_LLM_API_KEY=
PROSPECTOR_LLM_MODEL_STRONG=qwen3.7-max
PROSPECTOR_LLM_MODEL_MID=qwen3.7-plus
EXA_API_KEY=

# Set to 1 to dump OTel spans as pretty JSON on stdout (noisy; off by default).
PROSPECTOR_OTEL_CONSOLE=0
